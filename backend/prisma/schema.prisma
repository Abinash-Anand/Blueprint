// Engineering City — database schema.
// Curriculum (District, Topic, Subtopic, Resource, TopicDependency) is seeded.
// Calendar (Stage, Task, WeeklyTarget, Settings) is generated once, then owned by the learner.
// Learning activity (Subtopic.completedAt, Topic.demonstratedAt, StudySession) is learner-owned.
// Derived values (topic status, totals, road progress) are computed at read time, never stored.
// Revision (RevisionPrompt, RevisionSchedule, RevisionAttempt, LearningCheckpoint) is learner-owned history,
// except curriculum prompts, which are seeded. Attempts are immutable apart from confirming a correction.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  CORE
  IMPORTANT
  OPTIONAL
}

enum ResourceKind {
  ROADMAP
  DOCS
  COURSE
  ARTICLE
}

enum StageKind {
  MAIN
  PARALLEL
}

enum TaskKind {
  STUDY
  PRACTICE
  REVISION
}

enum TaskStatus {
  TODO
  DONE
  SKIPPED
}

enum TaskSource {
  PLAN
  MANUAL
  REVISION // created by the revision scheduler, linked to a RevisionSchedule
}

enum RevisionScope {
  SUBTOPIC
  TOPIC
}

enum RetrievalMethod {
  CONCEPTUAL // explain in your own words
  QUESTION_ANSWER
  WRITTEN // write from memory (syntax, APIs)
  VISUAL // diagram, concept map
  PRACTICAL // implement, solve, debug
  SCENARIO // compare alternatives, decide in a situation
}

enum PromptSource {
  CURRICULUM
  TEMPLATE
  LEARNER
}

enum CheckpointResult {
  RECALLED
  PARTIAL
  NOT_RECALLED
}

model District {
  id       String  @id // slug, e.g. "be" ("<cityPrefix>be" in later cities)
  cityId   String  @default("") /// "" matches no city: a create outside the city scope fails on the foreign key
  city     City    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  position Int // 0..n-1, road order within the city
  name     String
  subtitle String
  layer    Int // 1..5
  color    String  @db.Char(7) // "#rrggbb"
  cols     Int // building grid columns on the platform
  goal     String
  note     String
  topics   Topic[]
  stages   Stage[]

  @@unique([cityId, position])
}

model Topic {
  id                String               @id // slug, e.g. "be.api"
  cityId            String               @default("") /// "" matches no city: a create outside the city scope fails on the foreign key
  city              City                 @relation(fields: [cityId], references: [id], onDelete: Cascade)
  districtId        String
  district          District             @relation(fields: [districtId], references: [id], onDelete: Cascade)
  position          Int
  name              String
  description       String
  priority          Priority
  estimatedHours    Int
  exercise          String
  demonstratedAt    DateTime?            @db.Timestamptz(3)
  demonstrationNote String?
  needsReview       Boolean              @default(false)
  subtopics         Subtopic[]
  resources         Resource[]
  dependsOn         TopicDependency[]    @relation("dependent")
  requiredBy        TopicDependency[]    @relation("prerequisite")
  tasks             Task[]
  sessions          StudySession[]
  prompts           RevisionPrompt[]
  revisionSchedules RevisionSchedule[]
  checkpoints       LearningCheckpoint[]
  revisionMaterials RevisionMaterial[]
  revisionPacks     RevisionPack[]
  revisionTrack     RevisionTrack?
  revisionResponses RevisionResponse[]
  conceptResults    ConceptResult[]

  @@unique([districtId, position])
  @@index([cityId])
}

model Subtopic {
  id               Int                  @id @default(autoincrement())
  topicId          String
  topic            Topic                @relation(fields: [topicId], references: [id], onDelete: Cascade)
  position         Int
  name             String
  completedAt      DateTime?            @db.Timestamptz(3)
  tasks            Task[]
  prompts          RevisionPrompt[]
  revision         RevisionSchedule?
  checkpoints      LearningCheckpoint[]
  concepts         RevisionConcept[]
  recallChecklists RecallChecklist[]
  recallState      RecallState?
  recallReviews    RecallReview[]

  @@unique([topicId, position])
}

model Resource {
  id       Int          @id @default(autoincrement())
  topicId  String
  topic    Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  position Int
  label    String
  url      String
  kind     ResourceKind

  @@unique([topicId, position])
}

model TopicDependency {
  topicId     String
  topic       Topic  @relation("dependent", fields: [topicId], references: [id], onDelete: Cascade)
  dependsOnId String
  dependsOn   Topic  @relation("prerequisite", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([topicId, dependsOnId])
}

model Stage {
  id        String     @id // slug, e.g. "bedb"
  cityId    String     @default("") /// "" matches no city: a create outside the city scope fails on the foreign key
  city      City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  position  Int
  name      String
  kind      StageKind
  startDate DateTime   @db.Date
  endDate   DateTime   @db.Date
  /// ISO weekdays (1 = Monday … 7 = Sunday) the stage studies on, from its curriculum; empty: every day with time.
  weekdays  Int[]      @default([])
  /// Stages with the same queue share one sequence of topics (the planner's queues); empty: its own.
  queue     String     @default("")
  districts District[]
  tasks     Task[]

  @@unique([cityId, position])
}

model Task {
  id                 Int               @id @default(autoincrement())
  cityId             String            @default("") /// "" matches no city: a create outside the city scope fails on the foreign key
  city               City              @relation(fields: [cityId], references: [id], onDelete: Cascade)
  topicId            String?
  topic              Topic?            @relation(fields: [topicId], references: [id], onDelete: SetNull)
  subtopicId         Int?
  subtopic           Subtopic?         @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  stageId            String?
  stage              Stage?            @relation(fields: [stageId], references: [id], onDelete: SetNull)
  title              String
  notes              String            @default("")
  kind               TaskKind
  estimatedMinutes   Int
  originalDate       DateTime          @db.Date
  scheduledDate      DateTime          @db.Date
  position           Int               @default(0) // order within its original day
  status             TaskStatus        @default(TODO)
  completedAt        DateTime?         @db.Timestamptz(3)
  source             TaskSource
  rescheduleCount    Int               @default(0)
  /// When the learner moved this task by hand: the scheduler then leaves it where it is until it is unpinned.
  pinnedAt           DateTime?         @db.Timestamptz(3)
  /// Set for scheduler-created revision tasks. At most one TODO task per schedule (partial unique index, REV-13).
  revisionScheduleId Int?
  revisionSchedule   RevisionSchedule? @relation(fields: [revisionScheduleId], references: [id], onDelete: SetNull)
  /// Set for a recall task (docs/Recall-Plan.md): at most one TODO task per sub-topic in recall (partial unique index).
  recallStateId      Int?
  recallState        RecallState?      @relation(fields: [recallStateId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)
  sessions           StudySession[]
  attempts           RevisionAttempt[]

  @@index([cityId, scheduledDate])
  @@index([cityId, status, scheduledDate])
  @@index([topicId])
  @@index([recallStateId])
  @@index([stageId])
  @@index([revisionScheduleId])
}

model StudySession {
  id        Int      @id @default(autoincrement())
  cityId    String   @default("") /// "" matches no city: a create outside the city scope fails on the foreign key
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  minutes   Int
  taskId    Int?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  topicId   String?
  topic     Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  note      String   @default("")
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([cityId, date])
  @@index([taskId])
}

model Settings {
  id                            Int       @id @default(autoincrement())
  cityId                        String    @unique @default("")
  city                          City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  journeyStart                  DateTime  @db.Date
  journeyEnd                    DateTime  @db.Date
  timezone                      String
  /// Revision minutes every study day accepts on top of planned learning (REVISION_POLICY.dailyBudgetMinutes).
  revisionDailyMinutes          Int       @default(30)
  /// Over-target revision minutes a week may carry (REVISION_POLICY.weeklyOvertimeMinutes).
  revisionWeeklyOvertimeMinutes Int       @default(120)
  /// The finish date the learner asked for (null: none); the forecast checks it, nothing moves the plan to it.
  targetDate                    DateTime? @db.Date
  /// When the learner accepted the AI first-use notice (AI design §8.3); null until then.
  aiConsentAt                   DateTime? @db.Timestamptz(3)
  /// The city's "today" when the plan was last re-planned for a new day (docs/Scheduler-Phase2-Plan.md §2.4).
  replannedFor                  DateTime? @db.Date
  /// When this city's study starts each day (minutes after midnight, in its time zone); null = not chosen, the calendar
  /// uses its default start (docs/Google-Calendar-MVP-Plan.md §9).
  studyStartMinute              Int?
}

model WeeklyTarget {
  cityId           String @default("") /// "" matches no city: a create outside the city scope fails on the foreign key
  city             City   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  weekday          Int // ISO 8601: 1 = Monday … 7 = Sunday
  /// New-material minutes the plan fills on this weekday (the allocation).
  targetMinutes    Int
  /// Minutes the learner can study on this weekday (availability); the rest after targetMinutes is revision time.
  /// Null on rows from before availability was kept: read as targetMinutes.
  availableMinutes Int?

  @@id([cityId, weekday])
}

/// A question or challenge for retrieval practice (spec §4). Curriculum prompts are seeded; template prompts are
/// created the first time a template is used for a unit; learner prompts are written by the learner.
model RevisionPrompt {
  id              Int                  @id @default(autoincrement())
  /// Stable key for seeded and template prompts ("cur:<topic>:<n>", "tpl:<template>:<unit>"); null for learner prompts.
  key             String?              @unique
  cityId          String               @default("") /// "" matches no city: a create outside the city scope fails on the foreign key
  city            City                 @relation(fields: [cityId], references: [id], onDelete: Cascade)
  topicId         String
  topic           Topic                @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subtopicId      Int?
  subtopic        Subtopic?            @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  title           String
  content         String
  retrievalMethod RetrievalMethod
  expectedAnswer  String
  difficulty      Int? // 1..3
  source          PromptSource
  templateKey     String?
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)
  attempts        RevisionAttempt[]
  checkpoints     LearningCheckpoint[]
  evaluations     RevisionEvaluation[]

  @@index([topicId])
  @@index([cityId])
}

/// Current scheduling state of one revision unit: a sub-topic or a whole topic (spec §12.1).
/// SCHEDULED / DUE / OVERDUE are derived from nextDueDate; only suspension and the correction state are stored.
model RevisionSchedule {
  id                   Int                  @id @default(autoincrement())
  /// "s:<subtopicId>" or "t:<topicId>" (a CHECK keeps it consistent), so topic and sub-topic units never collide.
  unit                 String               @unique
  cityId               String               @default("") /// "" matches no city: a create outside the city scope fails on the foreign key
  city                 City                 @relation(fields: [cityId], references: [id], onDelete: Cascade)
  scope                RevisionScope
  topicId              String
  topic                Topic                @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subtopicId           Int?                 @unique
  subtopic             Subtopic?            @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  eligibleSince        DateTime             @db.Date
  /// null while a score-0 attempt waits for its correction.
  nextDueDate          DateTime?            @db.Date
  lastAttemptAt        DateTime?            @db.Timestamptz(3)
  lastAttemptDate      DateTime?            @db.Date
  lastScore            Int?
  previousIntervalDays Int                  @default(0)
  consecutiveSuccesses Int                  @default(0)
  consecutiveFailures  Int                  @default(0)
  correctionPending    Boolean              @default(false)
  /// Set while the unit is no longer eligible (sub-topic unticked); history is kept.
  suspendedAt          DateTime?            @db.Timestamptz(3)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)
  attempts             RevisionAttempt[]
  tasks                Task[]
  evaluations          RevisionEvaluation[]

  @@index([topicId])
  @@index([cityId, nextDueDate])
}

/// One retrieval attempt (spec §7.2). Immutable after submission except for confirming the correction.
model RevisionAttempt {
  id                  Int                 @id @default(autoincrement())
  cityId              String              @default("") /// "" matches no city: a create outside the city scope fails on the foreign key
  city                City                @relation(fields: [cityId], references: [id], onDelete: Cascade)
  scheduleId          Int
  schedule            RevisionSchedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  promptId            Int?
  prompt              RevisionPrompt?     @relation(fields: [promptId], references: [id], onDelete: SetNull)
  taskId              Int?
  task                Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  /// Prompt text as shown at the time, so later prompt edits never rewrite history.
  promptText          String
  score               Int // 0..3 as assessed by the learner
  effectiveScore      Int // what the scheduler used (a 3 with hints or notes counts as 2)
  retrievalMethod     RetrievalMethod
  attemptedAt         DateTime            @default(now()) @db.Timestamptz(3)
  attemptDate         DateTime            @db.Date
  durationMinutes     Int?
  usedHints           Boolean
  usedNotes           Boolean
  response            String              @default("")
  mistakes            String              @default("")
  correctionCompleted Boolean
  correctedAt         DateTime?           @db.Timestamptz(3)
  comment             String              @default("")
  intervalDays        Int
  nextDueDate         DateTime?           @db.Date
  /// AI assessment the learner looked at before saving (AI design §5.3); reference only, never changes scheduling.
  evaluationId        Int?                @unique
  evaluation          RevisionEvaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)
  /// Score the learner committed before seeing AI feedback (0..3); null when AI was not used.
  selfScore           Int?
  inputMode           InputMode           @default(TYPED)

  @@index([scheduleId, attemptedAt])
  @@index([attemptDate])
}

/// Active recall embedded in initial learning (spec §6). Never changes learned status or the revision schedule.
model LearningCheckpoint {
  id               Int              @id @default(autoincrement())
  cityId           String           @default("") /// "" matches no city: a create outside the city scope fails on the foreign key
  city             City             @relation(fields: [cityId], references: [id], onDelete: Cascade)
  topicId          String
  topic            Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subtopicId       Int
  subtopic         Subtopic         @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  promptId         Int?
  prompt           RevisionPrompt?  @relation(fields: [promptId], references: [id], onDelete: SetNull)
  promptText       String
  result           CheckpointResult
  neededAssistance Boolean
  gaps             String           @default("")
  response         String           @default("")
  date             DateTime         @db.Date
  completedAt      DateTime         @default(now()) @db.Timestamptz(3)

  @@index([topicId])
}

enum EvaluationStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum InputMode {
  TYPED
  SPOKEN
}

enum AiOperation {
  TRANSCRIBE
  EVALUATE
  GENERATE
  /// Reading a new city's goal and plan into a structured summary (city creation, AI design §10.4).
  UNDERSTAND
  /// Building a topic's revision pack (Revision v2 plan §5).
  REVISION_PACK
  /// Recall (docs/Recall-Plan.md): building a sub-topic's checklist and grading an explanation.
  RECALL
}

/// One AI assessment of one answer to one prompt (AI design §5.1). Immutable once SUCCEEDED or FAILED.
model RevisionEvaluation {
  id               Int                  @id @default(autoincrement())
  cityId           String               @default("") /// "" matches no city: a create outside the city scope fails on the foreign key
  city             City                 @relation(fields: [cityId], references: [id], onDelete: Cascade)
  scheduleId       Int
  schedule         RevisionSchedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  promptId         Int?
  prompt           RevisionPrompt?      @relation(fields: [promptId], references: [id], onDelete: SetNull)
  /// The evaluation a follow-up answer responds to.
  parentId         Int?
  parent           RevisionEvaluation?  @relation("FollowUp", fields: [parentId], references: [id], onDelete: Cascade)
  followUps        RevisionEvaluation[] @relation("FollowUp")
  /// sha256 of prompt version, model, prompt text, criteria, transcript, follow-up question and parent id.
  inputHash        String
  promptText       String
  criteriaText     String
  transcript       String
  followUpQuestion String?
  status           EvaluationStatus     @default(PENDING)
  /// Validated result plus derived fields (criteria verdicts, suggested mistakes, assisted flag).
  result           Json?
  suggestedScore   Int?
  errorCode        String?
  provider         String
  model            String
  promptVersion    String
  latencyMs        Int?
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  completedAt      DateTime?            @db.Timestamptz(3)
  attempt          RevisionAttempt?

  @@unique([scheduleId, inputHash])
  @@index([createdAt])
}

/// Cost and reliability ledger (AI design §5.1). Never holds transcript, prompt or audio.
model AiUsage {
  id           Int         @id @default(autoincrement())
  at           DateTime    @default(now()) @db.Timestamptz(3)
  operation    AiOperation
  provider     String
  model        String
  inputTokens  Int?
  outputTokens Int?
  audioSeconds Int?
  /// Estimated from configured prices; 1 EUR = 1 000 000.
  costMicroEur Int         @default(0)
  latencyMs    Int
  /// OK, TIMEOUT, PROVIDER_ERROR, INVALID_OUTPUT, RATE_LIMITED
  outcome      String

  @@index([at])
}

// ---------------------------------------------------------------------------------------------------------------------
// Multi-user foundation (sprint, 18 Nov 2026; docs/Sprint-Multi-User.md)
// ---------------------------------------------------------------------------------------------------------------------

enum CityStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum AuthTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum CurriculumSource {
  BUILTIN
  TEMPLATE
  IMPORT
  GENERATED
}

enum CurriculumVersionStatus {
  /// A generator is writing it (background job); content is filled in when it finishes.
  GENERATING
  /// Generation failed; `error` says why. Nothing in the city changed.
  FAILED
  PROPOSED
  APPLIED
  REJECTED
}

/// An account. Only what sign-in, display and the learner's own settings need (data minimisation).
model User {
  id                String            @id @default(cuid())
  /// Lower-cased; unique.
  email             String            @unique
  name              String
  /// Argon2id hash (PHC string); the password itself is never stored.
  passwordHash      String
  emailVerifiedAt   DateTime?         @db.Timestamptz(3)
  timezone          String            @default("Europe/Berlin")
  language          String            @default("en")
  /// Application preferences: reduced motion, default daily minutes, … (validated by the settings API).
  preferences       Json              @default("{}")
  onboardedAt       DateTime?         @db.Timestamptz(3)
  passwordChangedAt DateTime          @default(now()) @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  sessions          Session[]
  tokens            AuthToken[]
  consents          ConsentRecord[]
  cities            City[]
  googleConnection  GoogleConnection?
}

/// A signed-in browser. The id is the SHA-256 of the cookie value, so a database leak does not leak sessions.
model Session {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  remember   Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

/// One-time e-mail token (verification, password reset). The id is the SHA-256 of the token sent by e-mail.
model AuthToken {
  id        String           @id
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   AuthTokenPurpose
  expiresAt DateTime         @db.Timestamptz(3)
  usedAt    DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  @@index([userId, purpose])
}

/// Append-only record of what the user agreed to or withdrew, with the policy version (GDPR Art. 7(1)).
model ConsentRecord {
  id            Int      @id @default(autoincrement())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// TERMS and PRIVACY_NOTICE are required acknowledgements; AI_PROCESSING is optional and can be withdrawn.
  purpose       String
  policyVersion String
  granted       Boolean
  at            DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, purpose, at])
}

/// Ids of deleted accounts (no personal data), so a deletion can be re-applied after restoring an older backup.
model DeletedAccount {
  userId    String   @id
  deletedAt DateTime @default(now()) @db.Timestamptz(3)
}

/// A learning environment ("city"). Every learning record belongs to exactly one city, and a city to one user.
model City {
  id                String               @id
  /// null only for the original Engineering City until an account claims it (docs/Sprint-Multi-User.md §3).
  ownerId           String?
  owner             User?                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Prefix of every curriculum id in this city ("" for the original city, so its ids never change).
  idPrefix          String               @unique
  name              String
  description       String               @default("")
  goal              String               @default("")
  category          String?
  status            CityStatus           @default(DRAFT)
  /// Built-in template the curriculum came from ("engineering"); its text is refreshed on start-up like before.
  template          String?
  /// Creation workflow answers (requirements and constraints), kept for a future curriculum generator.
  requirements      Json?
  constraints       Json?
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(3)
  pausedAt          DateTime?            @db.Timestamptz(3)
  archivedAt        DateTime?            @db.Timestamptz(3)
  completedAt       DateTime?            @db.Timestamptz(3)
  versions          CurriculumVersion[]
  attachments       CityAttachment[]
  revisionReports   RevisionReport[]
  revisionMaterials RevisionMaterial[]
  revisionPacks     RevisionPack[]
  revisionConcepts  RevisionConcept[]
  revisionItems     RevisionItem[]
  revisionTracks    RevisionTrack[]
  revisionSessions  RevisionSession[]
  revisionResponses RevisionResponse[]
  conceptResults    ConceptResult[]
  recallChecklists  RecallChecklist[]
  recallPoints      RecallPoint[]
  recallStates      RecallState[]
  recallReviews     RecallReview[]
  recallResults     RecallPointResult[]
  recallAnalyses    RecallAnalysis[]
  planChanges       PlanChange[]
  districts         District[]
  stages            Stage[]
  settings          Settings?
  weeklyTargets     WeeklyTarget[]
  topics            Topic[]
  tasks             Task[]
  sessions          StudySession[]
  prompts           RevisionPrompt[]
  schedules         RevisionSchedule[]
  attempts          RevisionAttempt[]
  checkpoints       LearningCheckpoint[]
  evaluations       RevisionEvaluation[]

  @@index([ownerId, status])
}

enum RevisionReportReason {
  OUT_OF_SYLLABUS
  UNCLEAR
  UNFAIR_CHECK
  OTHER
}

/// The learner flagging a revision question or an AI check (Revision v2 plan §3.4). Kept as a record: it never changes a
/// score or a question by itself. The ids are references at the time of the report, not foreign keys.
model RevisionReport {
  id           Int                  @id @default(autoincrement())
  cityId       String
  city         City                 @relation(fields: [cityId], references: [id], onDelete: Cascade)
  topicId      String?
  scheduleId   Int?
  promptId     Int?
  evaluationId Int?
  /// Revision v2: the answer and the stored question the report is about.
  responseId   Int?
  itemId       Int?
  promptText   String
  reason       RevisionReportReason
  note         String               @default("")
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)

  @@index([cityId])
}

/// A learner's own plan (PDF or text) added while creating a city. Only the extracted text is kept, never the file;
/// it is sent to the AI with the city's answers and is deleted with the city.
model CityAttachment {
  id        Int      @id @default(autoincrement())
  cityId    String
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name      String
  mimeType  String
  size      Int
  pages     Int?
  chars     Int
  text      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([cityId])
}

/// A version of a city's curriculum in the curriculum contract (CURRICULUM_CONTRACT_VERSION). Applying one never
/// deletes learning history: removed topics with progress are refused (docs/Sprint-Multi-User.md §versioning).
model CurriculumVersion {
  id              Int                     @id @default(autoincrement())
  cityId          String
  city            City                    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  version         Int
  status          CurriculumVersionStatus
  source          CurriculumSource
  contractVersion Int
  /// The validated curriculum document.
  content         Json
  /// Added, modified and removed districts and topics compared with the previously applied version.
  changes         Json?
  /// Background generation: { step, label, done, total } while GENERATING.
  progress        Json?
  /// Why generation failed (FAILED), for the learner.
  error           String?
  note            String                  @default("")
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)
  appliedAt       DateTime?               @db.Timestamptz(3)

  @@unique([cityId, version])
}

// ---------------------------------------------------------------------------------------------------------------------
// Revision v2, phase 1: material and the revision pack (docs/Revision-v2-Plan.md §5, §8)
// ---------------------------------------------------------------------------------------------------------------------

enum RevisionPackStatus {
  BUILDING
  READY
  FAILED
  /// An earlier version, kept when the pack is rebuilt.
  SUPERSEDED
}

enum RevisionPackBasis {
  /// Built from the learner's own material.
  MATERIAL
  /// Built from the topic's outline only (no material added).
  OUTLINE
}

enum RevisionConceptStatus {
  /// Its questions are being written (a concept the learner added).
  BUILDING
  READY
  /// Some levels have no valid question; the fixed templates fill in.
  NEEDS_QUESTIONS
}

enum RevisionContentSource {
  AI
  /// Changed by the learner.
  EDITED
  /// Written by the learner (a concept they added).
  LEARNER
}

/// What the learner studied for one topic: the extracted text of a file or of pasted notes, never the file itself.
/// Sent to the AI provider only to build this topic's revision pack; deleted with the topic or the city.
model RevisionMaterial {
  id        Int      @id @default(autoincrement())
  cityId    String   @default("") /// "" matches no city: a create outside the city scope fails on the foreign key
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  name      String
  mimeType  String
  size      Int
  pages     Int?
  chars     Int
  text      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([topicId])
  @@index([cityId])
}

/// One build of a topic's revision pack. The newest READY version is the one in use; rebuilding keeps older versions.
model RevisionPack {
  id            Int                @id @default(autoincrement())
  cityId        String             @default("") /// "" matches no city: a create outside the city scope fails on the foreign key
  city          City               @relation(fields: [cityId], references: [id], onDelete: Cascade)
  topicId       String
  topic         Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  version       Int
  status        RevisionPackStatus @default(BUILDING)
  basis         RevisionPackBasis
  language      String
  provider      String
  model         String
  promptVersion String
  /// Material ids and sizes the pack was built from (the text itself stays in RevisionMaterial).
  sources       Json               @default("[]")
  /// While BUILDING: { step, label, done, total, concepts? }.
  progress      Json?
  error         String?
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  completedAt   DateTime?          @db.Timestamptz(3)
  concepts      RevisionConcept[]

  @@unique([topicId, version])
  @@index([cityId])
}

/// A concept the learner covered, found in their material. Concepts stay fixed across cycles so results compare.
model RevisionConcept {
  id             Int                   @id @default(autoincrement())
  cityId         String                @default("") /// "" matches no city: a create outside the city scope fails on the foreign key
  city           City                  @relation(fields: [cityId], references: [id], onDelete: Cascade)
  packId         Int
  pack           RevisionPack          @relation(fields: [packId], references: [id], onDelete: Cascade)
  position       Int
  title          String
  summary        String
  subtopicId     Int?
  subtopic       Subtopic?             @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  /// string[]
  keyPoints      Json                  @default("[]")
  /// string[]
  misconceptions Json                  @default("[]")
  source         RevisionContentSource @default(AI)
  status         RevisionConceptStatus @default(READY)
  /// Left out by the learner ("not in what I studied"); kept so it can be brought back.
  removedAt      DateTime?             @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  items          RevisionItem[]
  responses      RevisionResponse[]
  results        ConceptResult[]

  @@index([packId])
  @@index([cityId])
}

/// One stored question for a concept at one level (1–6), open or multiple choice, with what a good answer contains.
model RevisionItem {
  id          Int                   @id @default(autoincrement())
  cityId      String                @default("") /// "" matches no city: a create outside the city scope fails on the foreign key
  city        City                  @relation(fields: [cityId], references: [id], onDelete: Cascade)
  conceptId   Int
  concept     RevisionConcept       @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  level       Int
  /// RECALL, EXPLAIN, TRICKY_CHOICE, PREDICT, SCENARIO, WHAT_HAPPENS, SPOT_ERROR, DEBUG, COMPARE, FIND_WRONG_LINE,
  /// BEST_FIX, JUDGE, APPLY, TWO_PART, SELECT_ALL, TRANSFER (pack.ts ITEM_KINDS)
  kind        String
  /// OPEN, CHOICE (one correct option) or MULTI (select all that are true)
  format      String
  situation   String                @default("")
  code        String?
  question    String
  answerSize  String                @default("")
  /// string[]: the points a good answer covers
  expected    Json
  modelAnswer String
  /// string[3]: direction, clue, partial example
  hints       Json
  /// [{ text, correct, explanation }] for CHOICE and MULTI
  options     Json?
  source      RevisionContentSource @default(AI)
  removedAt   DateTime?             @db.Timestamptz(3)
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)
  responses   RevisionResponse[]

  @@index([conceptId, level])
  @@index([cityId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Revision v2, phases 2 and 3: cycles, sessions and the evidence per answer (docs/Revision-v2-Plan.md §4, §6, §8)
// ---------------------------------------------------------------------------------------------------------------------

enum RevisionTrackState {
  ACTIVE
  /// All six cycles done.
  RETAINED
}

/// A topic's place in its six revision cycles. Created when its first pack is ready; the topic moves from sub-topic
/// schedules to v2 on its first v2 review (startedAt), after which those schedules stop creating revision tasks.
model RevisionTrack {
  id             Int                @id @default(autoincrement())
  cityId         String             @default("") /// "" matches no city: a create outside the city scope fails on the foreign key
  city           City               @relation(fields: [cityId], references: [id], onDelete: Cascade)
  topicId        String             @unique
  topic          Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  /// Completed cycles, 0 to 6; the cycle in progress is cycle + 1.
  cycle          Int                @default(0)
  state          RevisionTrackState @default(ACTIVE)
  nextDueDate    DateTime?          @db.Date
  lastReviewDate DateTime?          @db.Date
  /// The next review asks only the concepts that are still weak in the cycle in progress (plan §4.2).
  weakOnly       Boolean            @default(false)
  /// Optional check every 3 to 6 months after cycle 6 (off by default, plan §14.4).
  maintenance    Boolean            @default(false)
  startedAt      DateTime?          @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)

  @@index([cityId, nextDueDate])
}

enum RevisionSessionKind {
  /// Today's planned questions.
  PLANNED
  /// "Keep going": topics due tomorrow, revised early.
  EARLY
  /// "Keep going": practice on the weakest concepts; never changes a cycle or a date.
  PRACTICE
}

enum RevisionSessionStatus {
  ACTIVE
  FINISHED
}

/// One sitting: the questions planned in code, in order, with relearning questions appended while it runs.
model RevisionSession {
  id             Int                   @id @default(autoincrement())
  cityId         String                @default("") /// "" matches no city: a create outside the city scope fails on the foreign key
  city           City                  @relation(fields: [cityId], references: [id], onDelete: Cascade)
  date           DateTime              @db.Date
  kind           RevisionSessionKind
  status         RevisionSessionStatus @default(ACTIVE)
  budgetMinutes  Int
  plannedMinutes Int
  /// [{ itemId, conceptId, topicId, cycle, minutes, relearn }]
  queue          Json
  startedAt      DateTime              @default(now()) @db.Timestamptz(3)
  finishedAt     DateTime?             @db.Timestamptz(3)
  responses      RevisionResponse[]
  conceptResults ConceptResult[]

  @@index([cityId, date])
}

/// One answered question (plan §4.4). Question, expected points and model answer are copied, so the history stays
/// readable when the pack is edited, rebuilt or deleted. Nothing here is overwritten once the result is final.
model RevisionResponse {
  id          Int              @id @default(autoincrement())
  cityId      String           @default("") /// "" matches no city: a create outside the city scope fails on the foreign key
  city        City             @relation(fields: [cityId], references: [id], onDelete: Cascade)
  sessionId   Int
  session     RevisionSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  itemId      Int?
  item        RevisionItem?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  conceptId   Int?
  concept     RevisionConcept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  topicId     String
  topic       Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  cycle       Int
  /// The easier question asked at the end of a session for a missed concept.
  relearn     Boolean          @default(false)
  position    Int
  level       Int
  kind        String
  format      String
  question    String
  code        String?
  expected    Json
  modelAnswer String
  /// 0 not at all · 1 shaky · 2 fairly · 3 sure (open questions, before the answer is revealed)
  confidence  Int?
  /// TYPED, SPOKEN, CODE or CHOICE
  mode        String
  answer      String           @default("")
  /// Chosen option indexes (multiple choice).
  choice      Json?
  correct     Boolean?
  /// The AI check of an open answer: verdicts per point with quotes, misconceptions, feedback.
  evaluation  Json?
  hintsUsed   Int              @default(0)
  modelShown  Boolean          @default(false)
  /// 0 Forgot · 1 Struggled · 2 Recalled · 3 Strong recall
  suggested   Int?
  final       Int?
  seconds     Int?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  @@index([sessionId])
  @@index([conceptId])
  @@index([cityId])
}

/// A concept's rolled-up result in one cycle of one review (plan §4.4): what the history table shows.
model ConceptResult {
  id           Int              @id @default(autoincrement())
  cityId       String           @default("") /// "" matches no city: a create outside the city scope fails on the foreign key
  city         City             @relation(fields: [cityId], references: [id], onDelete: Cascade)
  conceptId    Int?
  concept      RevisionConcept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  conceptTitle String
  topicId      String
  topic        Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  sessionId    Int
  session      RevisionSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  cycle        Int
  /// 0 Forgot · 1 Struggled · 2 Recalled · 3 Strong recall, after the end-of-session relearning
  result       Int
  /// The result before relearning, when the concept needed it.
  firstResult  Int
  date         DateTime         @db.Date
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)

  @@index([topicId, cycle])
  @@index([conceptId])
  @@index([cityId])
}

/**
 * ---------------- Recall (docs/Recall-Plan.md) ----------------
 */

enum RecallReviewStatus {
  /// The learner is recalling; transcribed parts and typed text are saved as they come.
  DRAFT
  /// Sent for grading; waiting for the grading model (or retrying after a busy provider).
  WAITING
  /// Graded: results are ready.
  CHECKED
  /// Closed by the learner after the results.
  COMPLETE
}

enum RecallPointStatus {
  ACCURATE
  PARTIAL
  MISSED
}

enum RecallDepth {
  FOUNDATIONAL
  INTERMEDIATE
  MASTERY
}

enum RecallOutcome {
  PASS
  HOLD
  LAPSE
}

/// A sub-topic's locked checklist (plan §4): built once from the curriculum, hidden until after the first review.
model RecallChecklist {
  id            Int            @id @default(autoincrement())
  cityId        String         @default("") /// "" matches no city: a create outside the city scope fails on the foreign key
  city          City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  subtopicId    Int
  subtopic      Subtopic       @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  version       Int
  provider      String
  /// The model that wrote the checklist.
  model         String
  /// The model that grades explanations against it, pinned for the checklist's life (plan §5.5).
  gradingModel  String
  promptVersion String
  /// "en" or "de", from the curriculum's own words: the checklist's language, and what recordings are transcribed as.
  language      String         @default("en")
  lockedAt      DateTime       @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  points        RecallPoint[]
  reviews       RecallReview[]

  @@unique([subtopicId, version])
  @@index([cityId])
}

model RecallPoint {
  id          Int                 @id @default(autoincrement())
  cityId      String              @default("")
  city        City                @relation(fields: [cityId], references: [id], onDelete: Cascade)
  checklistId Int
  checklist   RecallChecklist     @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  /// c1, c2, … in checklist order.
  code        String
  position    Int
  label       String
  /// One line the grader uses to judge the point.
  description String
  /// The point stated as a correct answer would say it, for showing next to the learner's words (never graded). Written
  /// once per checklist and kept with it; null until written (the description is shown instead).
  statement   String?
  tier        Int
  weight      Int
  /// Left out by the learner ("not part of this sub-topic"): not scored from then on.
  leftOutAt   DateTime?           @db.Timestamptz(3)
  results     RecallPointResult[]

  @@unique([checklistId, code])
  @@index([cityId])
}

/// When a learned sub-topic is next due (plan §6.3).
model RecallState {
  id             Int       @id @default(autoincrement())
  cityId         String    @default("")
  city           City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  subtopicId     Int       @unique
  subtopic       Subtopic  @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  stage          Int       @default(0)
  /// null while the sub-topic is not learned (unticked): nothing is due.
  nextDueDate    DateTime? @db.Date
  lastReviewDate DateTime? @db.Date
  /// The last gap in days.
  lastGapDays    Int?
  tasks          Task[]
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@index([cityId, nextDueDate])
}

/// One recall of one sub-topic: the explanation, the grade, and what it did to the schedule. Kept as history.
model RecallReview {
  id               Int                 @id @default(autoincrement())
  cityId           String              @default("")
  city             City                @relation(fields: [cityId], references: [id], onDelete: Cascade)
  subtopicId       Int
  subtopic         Subtopic            @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  checklistId      Int
  checklist        RecallChecklist     @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  /// 1, 2, … per sub-topic.
  attempt          Int
  status           RecallReviewStatus  @default(DRAFT)
  date             DateTime            @db.Date
  /// Transcribed voice parts, in order (the audio is never stored).
  spokenParts      Json                @default("[]")
  typed            String              @default("")
  /// The text that was graded (spoken parts then typed text), frozen when sent.
  explanation      String              @default("")
  gradingModel     String?
  promptVersion    String?
  score            Float?
  depth            RecallDepth?
  outcome          RecallOutcome?
  /// [{ claim, correction }], each claim quoted from the explanation.
  misconceptions   Json                @default("[]")
  stageBefore      Int?
  stageAfter       Int?
  nextDueDate      DateTime?           @db.Date
  /// Why grading is waiting (provider busy, invalid output), for the learner.
  waitReason       String?
  /// Phase 3: literal descriptions of sketches the learner drew from memory ([{ description }]); photos are never stored.
  sketchParts      Json                @default("[]")
  /// Phase 2: the senior engineer's follow-up question(s) about the gaps, and the learner's answer. Never changes the score.
  followupQuestion String?
  followupAnswer   String?
  /// Phase 2: { foundationsSummary, architectureAndEdgeCasesSummary, focusNext, cuedReasoningRating } written at completion.
  seniorVerdict    Json?
  analysis         RecallAnalysis?
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  submittedAt      DateTime?           @db.Timestamptz(3)
  checkedAt        DateTime?           @db.Timestamptz(3)
  completedAt      DateTime?           @db.Timestamptz(3)
  results          RecallPointResult[]

  @@unique([subtopicId, attempt])
  @@index([cityId, status])
}

model RecallPointResult {
  id                Int               @id @default(autoincrement())
  cityId            String            @default("")
  city              City              @relation(fields: [cityId], references: [id], onDelete: Cascade)
  reviewId          Int
  review            RecallReview      @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  pointId           Int
  point             RecallPoint       @relation(fields: [pointId], references: [id], onDelete: Cascade)
  status            RecallPointStatus
  /// The learner's own words that show the point (verified in code); null when missed.
  evidence          String?
  /// Shown only when asked in the senior-engineer step (phase 2); never changes the score or the date.
  recalledWhenAsked Boolean           @default(false)

  @@unique([reviewId, pointId])
  @@index([cityId])
}

/// A re-plan that moved tasks (docs/Scheduler-Phase2-Plan.md): why, how many, and the projected finish before and after,
/// so the learner can see what changed and why.
model PlanChange {
  id           Int       @id @default(autoincrement())
  cityId       String    @default("")
  city         City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  at           DateTime  @default(now()) @db.Timestamptz(3)
  /// DAILY (a new day), AVAILABILITY (study time changed), STAGES (stage dates changed), OVERDUE (moved on request),
  /// CURRICULUM (a new curriculum version was approved).
  reason       String
  moved        Int
  finishBefore DateTime? @db.Date
  finishAfter  DateTime? @db.Date

  @@index([cityId, at])
}

/// Phase 2: how a sub-topic's recall changed since earlier reviews, worked out in code (diffPayload), with a short summary
/// written from that payload only (never from transcripts).
model RecallAnalysis {
  id          Int          @id @default(autoincrement())
  cityId      String       @default("")
  city        City         @relation(fields: [cityId], references: [id], onDelete: Cascade)
  reviewId    Int          @unique
  review      RecallReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  subtopicId  Int
  attempt     Int
  diffPayload Json
  /// "" when the summary could not be written; the payload is shown instead.
  narrative   String       @default("")
  model       String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  @@index([cityId, subtopicId])
}

/// Google Calendar sync (docs/Google-Calendar-MVP-Plan.md): one connection per account. Both tokens are encrypted at
/// rest (AES-256-GCM, CALENDAR_TOKEN_KEY); they never leave the server.
model GoogleConnection {
  userId          String            @id
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken    String
  accessToken     String?
  accessExpiresAt DateTime?         @db.Timestamptz(3)
  scope           String
  /// The "Blueprint" calendar the app made in the account; null until it is made.
  calendarId      String?
  /// Google's sync token after the last read of that calendar; null means the next read is a full one.
  syncToken       String?
  /// When study blocks start, in minutes after midnight in each city's time zone (18:00).
  startMinute     Int               @default(1080)
  /// Minutes before a block that Google reminds you (popup); 0 = no reminder.
  reminderMinutes Int               @default(10)
  /// The order cities' blocks follow each other on a day (city ids); cities not listed go last, oldest first.
  cityOrder       String[]          @default([])
  /// ACTIVE; PAUSED (sync failed too often: "Retry"); RECONNECT (Google refused the token).
  status          String            @default("ACTIVE")
  lastError       String?
  lastSyncedAt    DateTime?         @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  events          CalendarEvent[]
  jobs            CalendarJob[]
  channels        CalendarChannel[]
}

/// The local mirror of one study block: a city's day in the Blueprint calendar. Pages never ask Google.
model CalendarEvent {
  id            Int              @id @default(autoincrement())
  userId        String
  connection    GoogleConnection @relation(fields: [userId], references: [userId], onDelete: Cascade)
  /// No foreign key: a deleted city's blocks are removed from Google by the next push, then from here.
  cityId        String
  day           DateTime         @db.Date
  /// STUDY (study and practice tasks) or RECALL (the day's recalls), each its own event.
  kind          String           @default("STUDY")
  googleEventId String?
  etag          String?
  /// Hash of what was last written, so an unchanged block is never written again.
  contentHash   String?
  /// The start the learner chose by moving the block in Google (minutes after midnight); null = laid out by Blueprint.
  startMinute   Int?
  /// The start last written to Google, so a move in Google can be told from other edits.
  placedMinute  Int?
  /// Deleted in Google: not written again for that day; the plan is unchanged.
  hidden        Boolean          @default(false)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([userId, cityId, day, kind])
  @@index([userId, googleEventId])
}

/// Work for the sync worker: at most one waiting job per account and kind (PUSH, PULL, WATCH), merged on enqueue.
model CalendarJob {
  id          Int              @id @default(autoincrement())
  userId      String
  connection  GoogleConnection @relation(fields: [userId], references: [userId], onDelete: Cascade)
  kind        String
  runAt       DateTime         @db.Timestamptz(3)
  /// The latest request; a job asked for again while running runs once more.
  requestedAt DateTime         @db.Timestamptz(3)
  attempts    Int              @default(0)
  lockedUntil DateTime?        @db.Timestamptz(3)
  lastError   String?

  @@unique([userId, kind])
  @@index([runAt])
}

/// A Google push-notification channel on the Blueprint calendar (webhooks, where the API has a public https address).
model CalendarChannel {
  id         String           @id
  userId     String
  connection GoogleConnection @relation(fields: [userId], references: [userId], onDelete: Cascade)
  resourceId String
  /// Random secret Google sends back with every notification.
  token      String
  expiresAt  DateTime         @db.Timestamptz(3)

  @@index([expiresAt])
}
