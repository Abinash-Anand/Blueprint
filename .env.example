# Copy to .env and adjust. Every value is optional; docker-compose.yml has the same defaults.
# The database is never published outside Docker, but change the password anyway.
# Use URL-safe characters (letters, digits, - _ .) because it is embedded in DATABASE_URL.
POSTGRES_USER=engineering_city
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=engineering_city

# Host port for http://localhost (bound to 127.0.0.1 only). Use e.g. 8080 if port 80 is taken.
HTTP_PORT=80

# Pin "today" (YYYY-MM-DD) for demos or for testing deadlines. Leave empty for the real Berlin date.
APP_TODAY=

# ---- AI check and voice (docs/AI-Voice-Design.md §10, §10.1) ----
# Off by default: with AI_ENABLED=false the app works exactly as without AI.
AI_ENABLED=false
# Chosen setup: Gemini Flash on the free Google AI Studio tier for both answer checking and speech-to-text.
# The free tier sends nothing to billing, but Google may use what you send and people may review it.
AI_EVALUATION_PROVIDER=gemini
# Leave empty to follow AI_EVALUATION_PROVIDER (Claude has no speech-to-text, so "anthropic" checking keeps Gemini here).
AI_TRANSCRIPTION_PROVIDER=
# Pin the exact model IDs you benchmarked. Empty = gemini-3.8-flash (or claude-haiku-5-5 for anthropic).
AI_EVALUATION_MODEL=
AI_TRANSCRIPTION_MODEL=
# Tried once when Google reports the main model overloaded or down (HTTP 5xx), never on quota, timeout or bad output.
# Empty = gemini-2.5-flash (same provider, its own free quota); "none" = off.
AI_FALLBACK_MODEL=
# Keys live only in this file (git-ignored) and in the backend container. Never prefix them with VITE_.
GEMINI_API_KEY=
# Only for the paid alternative: AI_EVALUATION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Set just below the daily quota AI Studio shows for your project (0 = no daily cap).
AI_DAILY_REQUEST_LIMIT=0
# Budget applies only when prices are set (free tier: leave prices at 0).
AI_MONTHLY_BUDGET_EUR=5
AI_PRICE_INPUT_PER_MTOK_EUR=0
AI_PRICE_OUTPUT_PER_MTOK_EUR=0
AI_PRICE_AUDIO_PER_MIN_EUR=0
# 3.8 Flash answers in ~6 s but occasionally takes 20+ s; 60 s avoids needless failures.
AI_REQUEST_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------------------------------------------------
# E-mail (verification and password-reset links). Without SMTP_HOST, mails are saved in ./mail-outbox instead.
# Gmail: turn on 2-Step Verification, create an app password at https://myaccount.google.com/apppasswords,
# then fill in the two lines below and run: docker compose up -d backend
#   Test: docker compose exec backend node dist/src/tools/mailTest.js you@example.com
# Other providers work the same way (their SMTP host, port 587 or 465, user and password).
# ---------------------------------------------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: the sender shown (must be an address the SMTP account may send as). Default: Blueprint <SMTP_USER>
MAIL_FROM=

# ---------------------------------------------------------------------------------------------------------------------
# GWDG Academic Cloud (SAIA API) for the AI check and voice answers (AI design §10.2). Request a key through the
# KISSKI service page with your Academic Cloud account; keep it only here. Check access: cd backend &&
# npx tsx --env-file=../.env eval/models.ts
# To switch: AI_EVALUATION_PROVIDER=gwdg (speech follows), and remove AI_EVALUATION_MODEL / AI_TRANSCRIPTION_MODEL
# or set them to the exact ids that eval/models.ts lists. Defaults: qwen3.8-27b (fallback gemma-4-31b-it) and
# whisper-large-v3 (fallback whisper-large-v2). GWDG's limits replace the Gemini free-tier cap: raise
# AI_DAILY_REQUEST_LIMIT accordingly (0 = no cap of Blueprint's own).
# ---------------------------------------------------------------------------------------------------------------------
SAIA_API_KEY=
# AI_EVALUATION_FALLBACK_MODEL=gemma-4-31b-it
# AI_TRANSCRIPTION_FALLBACK_MODEL=whisper-large-v2
# AI_DISABLE_THINKING=true

# Google Calendar sync (docs/Google-Calendar-MVP-Plan.md, section 5). Off unless all three are set.
# The OAuth client ("Web application") needs the redirect URI <PUBLIC_URL>/api/calendar/google/callback,
# e.g. http://localhost/api/calendar/google/callback for Docker. The key encrypts Google's tokens at rest:
# openssl rand -base64 32 (keep it: changing it means connecting again).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CALENDAR_TOKEN_KEY=
