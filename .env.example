# Copy to .env and adjust. Every value is optional; docker-compose.yml has the same defaults.
# The database is never published outside Docker, but change the password anyway.
# Use URL-safe characters (letters, digits, - _ .) because it is embedded in DATABASE_URL.
POSTGRES_USER=engineering_city
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=engineering_city

# Host port for http://localhost (bound to 127.0.0.1 only). Use e.g. 8080 if port 80 is taken.
HTTP_PORT=80

# Pin "today" (YYYY-MM-DD) for demos or for testing deadlines. Leave empty for the real Berlin date.
APP_TODAY=
